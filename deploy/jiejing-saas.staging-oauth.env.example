# Jiejing staging OAuth/read-only validation environment.
# This profile is for the first real eBay read-only loop:
# seller OAuth -> backend token exchange -> Vault secret_ref -> read-only sync -> platform_data_packet.
#
# Do not commit a filled copy. Inject real values through the deployment secret manager.

JIEJING_SAAS_ENV=staging
JIEJING_SAAS_SESSION_SECRET=replace-with-32-plus-random-characters
JIEJING_ALLOW_HERMES_ADAPTERS=false
JIEJING_CORS_ORIGIN=https://staging.jiejing.example

# Current repo has a real HashiCorp Vault HTTP resolver. Tencent/Aliyun KMS are
# adapter contracts until their managed clients are implemented.
JIEJING_VAULT_ENABLED=true
JIEJING_VAULT_PROVIDER=vault
JIEJING_VAULT_LIVE_RESOLVE_ENABLED=true
JIEJING_VAULT_ADDR=http://jiejing-vault:8200
JIEJING_VAULT_TOKEN=inject-from-secret-manager
JIEJING_VAULT_MOUNT=secret
JIEJING_VAULT_KEYSPACE=jiejing-staging
JIEJING_VAULT_KV_VERSION=v2
JIEJING_VAULT_PATH_TEMPLATE={keyspace}/{company_id}/{store_id}/{secret_ref}
JIEJING_VAULT_SECRET_FIELD=
JIEJING_VAULT_LOCAL_SECRET_RESOLVER_ENABLED=false

# eBay OAuth app. The eBay developer portal RuName must point to:
# https://staging.jiejing.example/oauth/ebay/callback
JIEJING_EBAY_OAUTH_ENV=production
JIEJING_EBAY_ACCOUNT_DELETION_ENDPOINT_URL=https://app.jiejing.shop/webhooks/ebay/marketplace-account-deletion
JIEJING_EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=inject-from-secret-manager
JIEJING_EBAY_CLIENT_ID=inject-from-secret-manager
JIEJING_EBAY_RU_NAME=replace-with-ebay-ru-name
JIEJING_EBAY_CLIENT_SECRET=inject-from-secret-manager
JIEJING_EBAY_OAUTH_EXCHANGE_LIVE=true
JIEJING_EBAY_TOKEN_REFRESH_LIVE=true
JIEJING_EBAY_READ_ONLY_LIVE=true
JIEJING_EBAY_AUTO_REFRESH=false
JIEJING_EBAY_LOCAL_TOKEN_STORE_ENABLED=false
JIEJING_EBAY_ACCESS_TOKEN=
JIEJING_EBAY_REFRESH_TOKEN=
JIEJING_ENABLE_HERMES_EBAY_BRIDGE=false
JIEJING_ENABLE_HERMES_WSL_SECRET_LOOKUP=false
JIEJING_ALLOW_HERMES_MODEL_FALLBACK=false

# WeChat Pay APIv3 acceptance profile. Configuration can be complete while
# both external order/query traffic and payable QR creation remain disabled.
JIEJING_WECHAT_PAY_LIVE_API_ENABLED=false
JIEJING_WECHAT_PAY_CHARGE_ALLOWED=false
JIEJING_WECHAT_PAY_REFUND_ALLOWED=false
JIEJING_MEDIA_CREDIT_PURCHASE_ENABLED=false
JIEJING_MEDIA_CREDIT_ENFORCEMENT_ENABLED=false
JIEJING_WECHAT_PAY_APP_ID=
JIEJING_WECHAT_PAY_MCH_ID=
JIEJING_WECHAT_PAY_MERCHANT_SERIAL_NO=
JIEJING_WECHAT_PAY_MERCHANT_PRIVATE_KEY_PEM_B64=
JIEJING_WECHAT_PAY_API_V3_KEY=
JIEJING_WECHAT_PAY_PUBLIC_KEY_ID=
JIEJING_WECHAT_PAY_PUBLIC_KEY_PEM_B64=
JIEJING_WECHAT_PAY_NOTIFY_URL=https://app.jiejing.shop/billing/domestic/wechat-pay/notify
JIEJING_WECHAT_PAY_REFUND_NOTIFY_URL=https://app.jiejing.shop/billing/domestic/wechat-pay/refund-notify
JIEJING_DOMESTIC_BILLING_MAINTENANCE_ENABLED=true
JIEJING_DOMESTIC_BILLING_AUTO_RECONCILE_ENABLED=true
JIEJING_DOMESTIC_BILLING_MAINTENANCE_INTERVAL_SECONDS=300
JIEJING_DOMESTIC_BILLING_MAINTENANCE_MAX_COMPANIES=25
JIEJING_DOMESTIC_BILLING_MAINTENANCE_MAX_ORDERS=10
JIEJING_DOMESTIC_BILLING_MAINTENANCE_MAX_QUERIES=50

# Keep writes off. This validation is read-only only.
JIEJING_ENABLE_REAL_PLATFORM_WRITES=false
