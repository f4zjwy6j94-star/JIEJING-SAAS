# Jiejing independent SaaS staging environment.
# Do not put real secrets in Git. In production these values must come from
# Tencent Cloud KMS, Alibaba Cloud KMS, Vault, or the platform secret manager.

JIEJING_SAAS_ENV=staging
JIEJING_SAAS_SESSION_SECRET=replace-with-32-plus-random-characters
JIEJING_ALLOW_HERMES_ADAPTERS=false
JIEJING_ENABLE_DEMO_SESSION_BOOTSTRAP=false
JIEJING_OPERATOR_BOOTSTRAP_SECRET=replace-with-operator-only-secret-if-needed

# Database/queue are still contract-backed in this repo. The app will refuse
# unsafe production startup until managed drivers are implemented and wired.
JIEJING_DATABASE_ENGINE=postgres
JIEJING_DATABASE_ADAPTER=postgres-managed
JIEJING_DATABASE_URL=postgresql://jiejing:replace-password@postgres:5432/jiejing
JIEJING_QUEUE_PROVIDER=redis_streams
JIEJING_QUEUE_URL=redis://redis:6379/0

# Vault/KMS contract. Real secret values stay outside the SaaS database.
JIEJING_VAULT_ENABLED=true
JIEJING_VAULT_PROVIDER=tencent_kms
# Local dev-only secret resolver for testing secret_ref flow without Hermes.
# Keep false in staging/production; production must implement managed KMS/Vault.
JIEJING_VAULT_LOCAL_SECRET_RESOLVER_ENABLED=false
JIEJING_VAULT_LOCAL_SECRET_STORE_PATH=
# HashiCorp Vault KV resolver. Enable only when Vault audit, policy and
# backend network isolation are configured. The Vault token itself must be
# injected by the deployment secret manager, never committed.
JIEJING_VAULT_LIVE_RESOLVE_ENABLED=false
JIEJING_VAULT_ADDR=
JIEJING_VAULT_TOKEN=
JIEJING_VAULT_MOUNT=secret
JIEJING_VAULT_KEYSPACE=jiejing
JIEJING_VAULT_KV_VERSION=v2
JIEJING_VAULT_PATH_TEMPLATE={keyspace}/{company_id}/{store_id}/{secret_ref}
JIEJING_VAULT_SECRET_FIELD=

# eBay OAuth/read-only. Real client secret and seller refresh token go to KMS.
JIEJING_EBAY_OAUTH_ENV=production
JIEJING_EBAY_CLIENT_ID=replace-with-ebay-app-id
JIEJING_EBAY_RU_NAME=replace-with-ebay-ru-name
JIEJING_EBAY_CLIENT_SECRET=replace-with-kms-secret-reference-at-runtime
JIEJING_EBAY_OAUTH_EXCHANGE_LIVE=false
JIEJING_EBAY_TOKEN_REFRESH_LIVE=false
JIEJING_EBAY_READ_ONLY_LIVE=false
JIEJING_EBAY_AUTO_REFRESH=false
# Local Jiejing-owned OAuth token store for development migration only.
# Keep false in staging/production; production must resolve tokens through KMS/Vault.
JIEJING_EBAY_LOCAL_TOKEN_STORE_ENABLED=false
JIEJING_EBAY_LOCAL_TOKEN_STORE_PATH=
# Local migration bridge only. Keep false in staging/production; Jiejing
# production should use its own Vault/KMS, not the legacy Hermes credential dir.
JIEJING_ENABLE_HERMES_EBAY_BRIDGE=false
JIEJING_ENABLE_HERMES_WSL_SECRET_LOOKUP=false
JIEJING_ALLOW_HERMES_MODEL_FALLBACK=false
# Local verification only. Do not use this in production because short-lived
# access tokens expire quickly and should never be copied into frontend code.
JIEJING_EBAY_ACCESS_TOKEN=
# Production path. Store the seller refresh token in KMS/Vault and let the
# backend refresh short-lived access tokens; never expose it to Runtime/agents.
JIEJING_EBAY_REFRESH_TOKEN=replace-with-kms-secret-reference-at-runtime

# Model/search/media provider keys should also be loaded from KMS/Vault.
JIEJING_MODEL=deepseek-chat
JIEJING_MODEL_BASE_URL=https://api.deepseek.com/v1
JIEJING_MODEL_API_KEY=replace-with-kms-secret-reference-at-runtime
JIEJING_PUBLIC_SEARCH_LIVE_ENABLED=false
JIEJING_PUBLIC_SEARCH_API_KEY=replace-with-kms-secret-reference-at-runtime
TAVILY_API_KEY=replace-with-kms-secret-reference-at-runtime
FAL_KEY=replace-with-kms-secret-reference-at-runtime

# Paid SaaS billing. Staging can use stripe_test_mock to rehearse the full
# checkout/subscription/quota flow without a real Stripe account or charges.
# Paid launch must use Stripe with real price IDs, signed webhook, Checkout
# and Customer Portal.
JIEJING_BILLING_PROVIDER=manual_seed
JIEJING_STRIPE_SECRET_KEY=
JIEJING_STRIPE_WEBHOOK_SECRET=
JIEJING_BILLING_WEBHOOK_URL=https://staging.jiejing.example/billing/webhook
JIEJING_STRIPE_WEBHOOK_API_VERSION=2026-06-24.dahlia
JIEJING_STRIPE_WEBHOOK_API_VERSION_VERIFIED=false
JIEJING_STRIPE_ACCOUNT_ACTIVATED=false
JIEJING_STRIPE_LIVE_MODE_DASHBOARD_REVIEWED=false
JIEJING_STRIPE_GO_LIVE_CHECKLIST_EVIDENCE_ID=
JIEJING_STRIPE_TEST_MODE_OBJECTS_EXCLUDED=false
JIEJING_STRIPE_TAX_INVOICE_RECEIPT_REVIEWED=false
JIEJING_STRIPE_SUPPORT_CONTACT_BRANDING_REVIEWED=false
JIEJING_STRIPE_TAX_INVOICE_RECEIPT_EVIDENCE_ID=
JIEJING_STRIPE_WEBHOOK_FAILURE_PATH_EVIDENCE_ID=
JIEJING_STRIPE_CUSTOMER_PORTAL_FAILURE_PATH_EVIDENCE_ID=
JIEJING_CUTOVER_ROLLBACK_AUDIT_PACKET_ID=
JIEJING_PAID_LAUNCH_OWNER_APPROVAL_PACKET_ID=
JIEJING_STRIPE_PRICE_STARTER_ID=replace-with-stripe-starter-price-id
JIEJING_STRIPE_PRICE_OPERATOR_ID=replace-with-stripe-operator-price-id
JIEJING_STRIPE_PRICE_TEAM_ID=replace-with-stripe-team-price-id
JIEJING_BILLING_SUCCESS_URL=https://staging.jiejing.example/app.html?billing=success
JIEJING_BILLING_CANCEL_URL=https://staging.jiejing.example/app.html?billing=cancel
JIEJING_BILLING_PORTAL_RETURN_URL=https://staging.jiejing.example/app.html?view=connect&tab=launch
JIEJING_BILLING_PLANS_PUBLISHED=false
JIEJING_QUOTA_ENFORCEMENT_ENABLED=true

# Real writes must stay off until sandbox write adapter and audit are complete.
JIEJING_ENABLE_REAL_PLATFORM_WRITES=false
