# Jiejing staging database and queue runtime template.
# Copy to ../../private/postgres-localqueue.env on the staging host only.
# Replace every angle-bracket placeholder through the private deployment path;
# never commit a filled copy or print connection URLs in logs.

# PostgreSQL repository connection.
JIEJING_DATABASE_ENGINE=postgres
JIEJING_DATABASE_ADAPTER=postgres-managed
JIEJING_DATABASE_URL=<inject-private-postgres-url>
JIEJING_POSTGRES_DRIVER_CHECK_LIVE=true

# Redis Streams worker queue connection.
JIEJING_QUEUE_PROVIDER=redis_streams
JIEJING_QUEUE_URL=<inject-private-redis-url>
JIEJING_REDIS_STREAM=jiejing:queue
JIEJING_REDIS_CONSUMER_GROUP=jiejing-workers
JIEJING_REDIS_DEAD_LETTER_STREAM=jiejing:queue:dead
JIEJING_REDIS_WORKER_BLOCK_MS=1000
JIEJING_REDIS_DRIVER_CHECK_LIVE=true
