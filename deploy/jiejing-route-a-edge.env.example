# Route A edge-only environment.
# Copy to deploy/jiejing-route-a-edge.env on the overseas edge node.
# This node must not store eBay tokens, model keys, database URLs, or Tencent API keys.

JIEJING_EDGE_DOMAIN=app.jiejing.example
JIEJING_EDGE_UPSTREAM_HOST=individually-buffalo-prescribed-blocking.trycloudflare.com
JIEJING_TLS_EMAIL=ops@example.com
