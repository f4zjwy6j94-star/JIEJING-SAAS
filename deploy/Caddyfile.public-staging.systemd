(cloudflare_or_loopback_only) {
	@untrustedOrigin not remote_ip 127.0.0.1 ::1 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @untrustedOrigin {
		respond "Not found" 404
	}
}

jiejing.shop {
	import cloudflare_or_loopback_only

	handle {
		redir https://app.jiejing.shop{uri} 308
	}
}

app.jiejing.shop {
	import cloudflare_or_loopback_only

	encode zstd gzip

	header {
		X-Jiejing-Edge "route-a-hk-systemd"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
	}

	@blockedInternalPath {
		path /.git* /.github* /deploy* /tools* /docs* /tests* /jiejing_saas* /jiejing_runtime* /schemas* /output* /private*
	}
	handle @blockedInternalPath {
		respond "Not found" 404
	}

	@blockedInternalFile {
		path_regexp blockedInternalFile .*\.(env|pem|key|sqlite|db|py|pyc|md|ya?ml|toml|ini|log|bak|zip|tar|gz|ps1|sh|conf)$
	}
	handle @blockedInternalFile {
		respond "Not found" 404
	}

	handle /robots.txt {
		root * /opt/jiejing-staging/app
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:18080 {
			header_down -X-Frame-Options
			header_down -X-Content-Type-Options
			header_down -Referrer-Policy
			header_down -Permissions-Policy
			header_down -X-Robots-Tag
		}
	}
}

ops.jiejing.shop {
	encode zstd gzip

	header {
		X-Jiejing-Edge "route-a-hk-systemd-ops"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), serial=()"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}

	handle {
		reverse_proxy 127.0.0.1:18080 {
			header_down -X-Frame-Options
			header_down -X-Content-Type-Options
			header_down -Referrer-Policy
			header_down -Permissions-Policy
			header_down -Content-Security-Policy
			header_down -X-Robots-Tag
			header_down -Cross-Origin-Opener-Policy
			header_down -Cross-Origin-Resource-Policy
		}
	}
}
