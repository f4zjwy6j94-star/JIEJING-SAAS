# Jiejing SaaS production environment template.
# Keep this file as a template only. Real values must be injected by the
# deployment secret manager, Tencent Cloud KMS/Secrets Manager, or Vault.

JIEJING_SAAS_ENV=production
JIEJING_SAAS_SESSION_SECRET=replace-with-managed-secret
JIEJING_CORS_ORIGIN=https://app.example.com
JIEJING_ALLOW_HERMES_ADAPTERS=false
JIEJING_ENABLE_DEMO_SESSION_BOOTSTRAP=false
JIEJING_OPERATOR_BOOTSTRAP_SECRET=inject-at-runtime-if-operator-bootstrap-is-required
JIEJING_PLATFORM_TRIAL_ACTIVATION_REQUIRED=true
JIEJING_PLATFORM_TRIAL_ACTIVATION_MAX_PER_IP_PER_DAY=3
JIEJING_PLATFORM_TRIAL_ACTIVATION_MAX_GLOBAL_PER_DAY=200
# Keep false until the edge challenge is genuinely enabled and verified.
JIEJING_TURNSTILE_OR_CHALLENGE_ENABLED=false

JIEJING_DATABASE_ENGINE=postgres
JIEJING_DATABASE_ADAPTER=postgres-managed
JIEJING_DATABASE_URL=postgresql://jiejing:replace-password@tencentdb-postgres.example.internal:5432/jiejing
JIEJING_DATABASE_CONNECT_TIMEOUT_SECONDS=3
JIEJING_DATABASE_POOL_ENABLED=true
JIEJING_DATABASE_POOL_MIN_SIZE=1
JIEJING_DATABASE_POOL_MAX_SIZE=8
JIEJING_DATABASE_POOL_WAIT_TIMEOUT_SECONDS=5

JIEJING_QUEUE_PROVIDER=redis_streams
JIEJING_QUEUE_URL=redis://tencentdb-redis.example.internal:6379/0

JIEJING_VAULT_ENABLED=true
JIEJING_VAULT_PROVIDER=vault
JIEJING_VAULT_LIVE_RESOLVE_ENABLED=true
JIEJING_VAULT_ADDR=https://vault.example.internal
JIEJING_VAULT_TOKEN=inject-at-runtime
JIEJING_VAULT_MOUNT=secret
JIEJING_VAULT_KEYSPACE=jiejing-production
JIEJING_VAULT_KV_VERSION=v2
JIEJING_VAULT_PATH_TEMPLATE={keyspace}/{company_id}/{store_id}/{secret_ref}
JIEJING_VAULT_SECRET_FIELD=

JIEJING_EBAY_OAUTH_ENV=production
JIEJING_EBAY_ACCOUNT_DELETION_ENDPOINT_URL=https://app.jiejing.shop/webhooks/ebay/marketplace-account-deletion
JIEJING_EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=inject-from-secret-manager
JIEJING_EBAY_CLIENT_ID=inject-at-runtime
JIEJING_EBAY_CLIENT_SECRET=inject-at-runtime
JIEJING_EBAY_RU_NAME=inject-at-runtime
JIEJING_EBAY_OAUTH_EXCHANGE_LIVE=true
JIEJING_EBAY_TOKEN_REFRESH_LIVE=true
JIEJING_EBAY_READ_ONLY_LIVE=true
JIEJING_ENABLE_HERMES_EBAY_BRIDGE=false
JIEJING_ENABLE_HERMES_WSL_SECRET_LOOKUP=false
JIEJING_ALLOW_HERMES_MODEL_FALLBACK=false
JIEJING_ENABLE_REAL_PLATFORM_WRITES=false
JIEJING_EBAY_WRITE_LIVE=false
JIEJING_EBAY_DRAFT_SAVE_LIVE=false
JIEJING_PUBLIC_STAGING_REAL_WRITE_POLICY=disabled_public_staging

JIEJING_MODEL=deepseek-chat
JIEJING_MODEL_BASE_URL=https://api.deepseek.com/v1
JIEJING_MODEL_API_KEY=inject-at-runtime
JIEJING_PUBLIC_SEARCH_LIVE_ENABLED=true
JIEJING_PUBLIC_SEARCH_API_KEY=inject-at-runtime
FAL_KEY=inject-at-runtime
JIEJING_MEDIA_GENERATION_PROVIDER=fal
# Alternative image provider: set provider=openai and inject the key at runtime.
# Media provider secrets must stay in the backend secret manager.
JIEJING_MEDIA_OPENAI_API_KEY=inject-at-runtime
JIEJING_OPENAI_IMAGE_MODEL=gpt-image-1
JIEJING_MEDIA_GENERATED_ASSET_DIR=/var/lib/jiejing/media-assets
JIEJING_MEDIA_LIVE_PROVIDER_ENABLED=false
JIEJING_MEDIA_LIVE_VIDEO_ENABLED=false
JIEJING_FAL_VIDEO_MODEL=fal-ai/minimax/hailuo-2.3/standard/image-to-video
JIEJING_FAL_VIDEO_USE_QUEUE=true

# Paid SaaS billing. Use Stripe Billing + Checkout Sessions + Customer Portal.
# Real Stripe secrets must be injected by the deployment secret manager.
JIEJING_BILLING_PROVIDER=stripe
JIEJING_STRIPE_SECRET_KEY=inject-at-runtime
JIEJING_STRIPE_WEBHOOK_SECRET=inject-at-runtime
JIEJING_BILLING_WEBHOOK_URL=https://app.example.com/billing/webhook
JIEJING_STRIPE_WEBHOOK_API_VERSION=2026-06-24.dahlia
JIEJING_STRIPE_WEBHOOK_API_VERSION_VERIFIED=false
JIEJING_STRIPE_ACCOUNT_ACTIVATED=false
JIEJING_STRIPE_LIVE_MODE_DASHBOARD_REVIEWED=false
JIEJING_STRIPE_GO_LIVE_CHECKLIST_EVIDENCE_ID=
JIEJING_STRIPE_TEST_MODE_OBJECTS_EXCLUDED=false
JIEJING_STRIPE_TAX_INVOICE_RECEIPT_REVIEWED=false
JIEJING_STRIPE_SUPPORT_CONTACT_BRANDING_REVIEWED=false
JIEJING_STRIPE_TAX_INVOICE_RECEIPT_EVIDENCE_ID=
JIEJING_STRIPE_WEBHOOK_FAILURE_PATH_EVIDENCE_ID=
JIEJING_STRIPE_CUSTOMER_PORTAL_FAILURE_PATH_EVIDENCE_ID=
JIEJING_NO_CHARGE_CHECKOUT_RETURN_URL_SMOKE_PASSED=false
JIEJING_NO_CHARGE_PORTAL_RETURN_URL_SMOKE_PASSED=false
JIEJING_NO_CHARGE_SIGNED_WEBHOOK_SMOKE_PASSED=false
JIEJING_NO_CHARGE_READINESS_SMOKE_PASSED=false
JIEJING_NO_CHARGE_LIVE_DOMAIN_REHEARSAL_EVIDENCE_ID=
JIEJING_CUTOVER_ROLLBACK_AUDIT_PACKET_ID=
JIEJING_PAID_LAUNCH_OWNER_APPROVAL_PACKET_ID=
JIEJING_STRIPE_PRICE_STARTER_ID=replace-with-stripe-starter-price-id
JIEJING_STRIPE_PRICE_OPERATOR_ID=replace-with-stripe-operator-price-id
JIEJING_STRIPE_PRICE_TEAM_ID=replace-with-stripe-team-price-id
JIEJING_BILLING_SUCCESS_URL=https://app.example.com/app.html?start=app&view=connect&billing=success
JIEJING_BILLING_CANCEL_URL=https://app.example.com/app.html?start=app&view=connect&billing=cancel
JIEJING_BILLING_PORTAL_RETURN_URL=https://app.example.com/app.html?start=app&view=connect&billing=portal
JIEJING_BILLING_PLANS_PUBLISHED=false
JIEJING_QUOTA_ENFORCEMENT_ENABLED=true

# Mainland WeChat Pay Native (APIv3). Secrets are backend-only values injected
# by the deployment secret manager; paid checkout stays off by default.
JIEJING_WECHAT_PAY_LIVE_API_ENABLED=false
JIEJING_WECHAT_PAY_CHARGE_ALLOWED=false
JIEJING_WECHAT_PAY_REFUND_ALLOWED=false
JIEJING_MEDIA_CREDIT_PURCHASE_ENABLED=false
JIEJING_MEDIA_CREDIT_ENFORCEMENT_ENABLED=false
JIEJING_WECHAT_PAY_APP_ID=
JIEJING_WECHAT_PAY_MCH_ID=
JIEJING_WECHAT_PAY_MERCHANT_SERIAL_NO=
JIEJING_WECHAT_PAY_MERCHANT_PRIVATE_KEY_PEM_B64=
JIEJING_WECHAT_PAY_API_V3_KEY=
JIEJING_WECHAT_PAY_PUBLIC_KEY_ID=
JIEJING_WECHAT_PAY_PUBLIC_KEY_PEM_B64=
JIEJING_WECHAT_PAY_NOTIFY_URL=https://app.jiejing.shop/billing/domestic/wechat-pay/notify
JIEJING_WECHAT_PAY_REFUND_NOTIFY_URL=https://app.jiejing.shop/billing/domestic/wechat-pay/refund-notify
JIEJING_DOMESTIC_BILLING_MAINTENANCE_ENABLED=true
JIEJING_DOMESTIC_BILLING_AUTO_RECONCILE_ENABLED=true
JIEJING_DOMESTIC_BILLING_MAINTENANCE_INTERVAL_SECONDS=300
JIEJING_DOMESTIC_BILLING_MAINTENANCE_MAX_COMPANIES=25
JIEJING_DOMESTIC_BILLING_MAINTENANCE_MAX_ORDERS=10
JIEJING_DOMESTIC_BILLING_MAINTENANCE_MAX_QUERIES=50

# Registration challenge. Inject the secret only through the backend secret
# manager. The public site key may be returned by /auth/challenge-config.
JIEJING_TURNSTILE_SITE_KEY=
JIEJING_TURNSTILE_SECRET_KEY=
JIEJING_TURNSTILE_ALLOWED_HOSTNAMES=app.jiejing.shop
JIEJING_TURNSTILE_ACTION=jiejing_register
JIEJING_TURNSTILE_TIMEOUT_SECONDS=5
