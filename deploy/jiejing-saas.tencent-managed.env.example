# Jiejing Tencent Cloud managed infrastructure and operations-evidence template.
# Copy to ../../private/tencent-managed.env on the staging host only.
# Do not commit a filled copy. Keep database, queue, eBay, model, search, media,
# session, and real-write settings in their separately owned sources.

# Tencent Cloud region and network.
JIEJING_TENCENT_REGION=ap-guangzhou
JIEJING_TENCENT_ZONE=ap-guangzhou-4
JIEJING_TENCENT_VPC_ID=<current-vpc-id>
JIEJING_TENCENT_SUBNET_ID=<current-subnet-id>

# Tencent Cloud SSM/KMS and Vault runtime evidence. Tencent KMS manages
# encryption keys; SSM stores backend-only secret material by reference.
JIEJING_VAULT_ENABLED=true
JIEJING_VAULT_PROVIDER=tencent_ssm
JIEJING_TENCENT_SSM_LIVE_RESOLVE_ENABLED=true
JIEJING_TENCENT_SSM_LIVE_WRITE_ENABLED=true
JIEJING_TENCENT_SSM_KEYSPACE=jiejing-staging
JIEJING_TENCENT_SSM_SECRET_NAME_TEMPLATE={keyspace}-{company_id}-{store_id}-{purpose}-{secret_ref}
# Prefer server-side CAM injection. These placeholders are never usable keys.
JIEJING_TENCENT_SECRET_ID=<inject-private-tencent-secret-id>
JIEJING_TENCENT_SECRET_KEY=<inject-private-tencent-secret-key>

# Tencent CLS operational evidence.
JIEJING_CLS_ENABLED=true
JIEJING_CLS_REGION=ap-guangzhou
JIEJING_CLS_LOGSET_ID=<cls-logset-id>
JIEJING_CLS_TOPIC_ID=<cls-topic-id>
JIEJING_CLS_ALERT_POLICY_CONFIGURED=false
JIEJING_CLS_LIVE_PROBE_REQUIRED=true
JIEJING_CLS_LIVE_PROBE_LAST_AT=
JIEJING_CLS_INGESTION_LIVE_PROBE_PASSED=false
JIEJING_CLS_INGESTION_LIVE_PROBE_LAST_AT=
JIEJING_CLS_PROBE_MAX_AGE_HOURS=24

# Passive provider monitoring stays disabled until operator budgets and both
# CLS alarm read-backs are recorded.
JIEJING_PROVIDER_METRICS_ENABLED=false
JIEJING_PROVIDER_MONITOR_SCHEDULER_ENABLED=false
JIEJING_PROVIDER_MONITOR_INTERVAL_SECONDS=300
JIEJING_PROVIDER_MONITOR_WINDOW_MINUTES=30
JIEJING_PROVIDER_MONITOR_COST_WINDOW_HOURS=24
JIEJING_PROVIDER_MONITOR_EVIDENCE_MAX_AGE_MINUTES=15
JIEJING_PROVIDER_DAILY_COST_WARNING_MINOR=
JIEJING_PROVIDER_DAILY_COST_CRITICAL_MINOR=
JIEJING_PROVIDER_ALARM_NOTICE_ID=
JIEJING_PROVIDER_LATENCY_ALARM_VERIFIED_AT=
JIEJING_PROVIDER_COST_ALARM_VERIFIED_AT=
JIEJING_PROVIDER_ALARM_VERIFICATION_MAX_AGE_DAYS=7

# COS backup and restore evidence.
JIEJING_BACKUP_STORAGE_PROVIDER=cos
JIEJING_COS_BACKUP_ENABLED=true
JIEJING_COS_REGION=ap-guangzhou
JIEJING_COS_BUCKET=<private-backup-bucket>
JIEJING_COS_PREFIX=jiejing/staging/backups
JIEJING_COS_BACKUP_LIVE_PROBE_REQUIRED=true
JIEJING_COS_BACKUP_LAST_SUCCESS_AT=
JIEJING_BACKUP_PROBE_MAX_AGE_HOURS=36
JIEJING_BACKUP_POLICY_CONFIGURED=false
JIEJING_BACKUP_ALERTS_CONFIGURED=false
JIEJING_VAULT_BACKUP_POLICY_CONFIGURED=false
JIEJING_RESTORE_DRILL_LAST_AT=
JIEJING_RESTORE_DRILL_MAX_AGE_DAYS=30

# Owner-review evidence. These flags record completed reviews only; they do
# not enable public charging, payment-provider writes, refunds, or eBay writes.
JIEJING_PRODUCTION_RELEASE_CHARGE_FLAG_REVIEWED=false
JIEJING_PRODUCTION_RELEASE_REAL_WRITE_FLAG_REVIEWED=false
JIEJING_PRODUCTION_SUPPORT_REFUND_POLICY_REVIEWED=false
JIEJING_PRODUCTION_MERCHANT_SURFACE_COPY_SCAN_PASSED=false

# Published operational runbook evidence is managed-source state, not a
# Compose override. Keep the current verified staging capability represented.
JIEJING_BACKUP_RESTORE_DRILL_RUNBOOK_PUBLISHED=true
JIEJING_DATABASE_ENDPOINT_INCIDENT_RUNBOOK_PUBLISHED=true
