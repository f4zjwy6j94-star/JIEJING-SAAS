# Jiejing Tencent Cloud managed infrastructure template.
# Copy to a private env file on the staging server only.
# Do not commit filled values.

JIEJING_SAAS_ENV=staging
JIEJING_SAAS_SESSION_SECRET=replace-with-32-plus-random-characters
JIEJING_CORS_ORIGIN=https://individually-buffalo-prescribed-blocking.trycloudflare.com
JIEJING_ALLOW_HERMES_ADAPTERS=false
JIEJING_ENABLE_DEMO_SESSION_BOOTSTRAP=false
JIEJING_OPERATOR_BOOTSTRAP_SECRET=replace-with-operator-only-secret-if-needed

# Tencent Cloud region and network.
JIEJING_TENCENT_REGION=ap-guangzhou
JIEJING_TENCENT_ZONE=ap-guangzhou-4
JIEJING_TENCENT_VPC_ID=replace-with-current-vpc-id
JIEJING_TENCENT_SUBNET_ID=replace-with-current-subnet-id

# TencentDB for PostgreSQL.
JIEJING_DATABASE_ENGINE=postgres
JIEJING_DATABASE_ADAPTER=postgres-managed
# Current TencentDB private endpoint seen in console: 172.16.0.12:5432.
# Keep the password only in a server-private env file or SSM; do not commit it.
JIEJING_DATABASE_URL=postgresql://jiejing:replace-password@172.16.0.12:5432/jiejing
JIEJING_POSTGRES_DRIVER_CHECK_LIVE=true

# TencentDB for Redis using Redis Streams.
JIEJING_QUEUE_PROVIDER=redis_streams
# Current TencentDB private endpoint seen in console: 172.16.0.15:6379.
# Keep the password only in a server-private env file or SSM; do not commit it.
JIEJING_QUEUE_URL=redis://:replace-password@172.16.0.15:6379/0
JIEJING_REDIS_STREAM=jiejing:queue
JIEJING_REDIS_DEAD_LETTER_STREAM=jiejing:queue:dead
JIEJING_REDIS_DRIVER_CHECK_LIVE=true

# Tencent Cloud SSM/KMS target.
# Tencent KMS manages encryption keys; SSM stores string secrets such as eBay
# refresh tokens and model/search provider keys.
JIEJING_VAULT_ENABLED=true
JIEJING_VAULT_PROVIDER=tencent_ssm
JIEJING_TENCENT_SSM_LIVE_RESOLVE_ENABLED=true
JIEJING_TENCENT_SSM_LIVE_WRITE_ENABLED=true
JIEJING_TENCENT_SSM_KEYSPACE=jiejing-staging
JIEJING_TENCENT_SSM_SECRET_NAME_TEMPLATE={keyspace}-{company_id}-{store_id}-{purpose}-{secret_ref}
# Prefer server-side CAM/secret injection. If using static Tencent API keys,
# keep them only in the private server env file; never commit filled values.
JIEJING_TENCENT_SECRET_ID=inject-private-tencent-secret-id
JIEJING_TENCENT_SECRET_KEY=inject-private-tencent-secret-key

# eBay remains read-only. Do not set raw access/refresh tokens in env.
JIEJING_EBAY_OAUTH_ENV=production
JIEJING_EBAY_ACCOUNT_DELETION_ENDPOINT_URL=https://app.jiejing.shop/webhooks/ebay/marketplace-account-deletion
JIEJING_EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=inject-from-secret-manager
JIEJING_EBAY_CLIENT_ID=inject-from-ssm
JIEJING_EBAY_CLIENT_SECRET=inject-from-ssm
JIEJING_EBAY_RU_NAME=inject-from-private-env
JIEJING_EBAY_OAUTH_EXCHANGE_LIVE=true
JIEJING_EBAY_TOKEN_REFRESH_LIVE=true
JIEJING_EBAY_READ_ONLY_LIVE=true
JIEJING_EBAY_AUTO_REFRESH=false
JIEJING_EBAY_LOCAL_TOKEN_STORE_ENABLED=false
JIEJING_EBAY_ACCESS_TOKEN=
JIEJING_EBAY_REFRESH_TOKEN=
JIEJING_ENABLE_HERMES_EBAY_BRIDGE=false
JIEJING_ENABLE_HERMES_WSL_SECRET_LOOKUP=false
JIEJING_ALLOW_HERMES_MODEL_FALLBACK=false

# Provider keys should be resolved by backend-only SSM/Vault logic.
JIEJING_MODEL=deepseek-chat
JIEJING_MODEL_BASE_URL=https://api.deepseek.com/v1
JIEJING_MODEL_API_KEY=inject-from-ssm
JIEJING_PUBLIC_SEARCH_LIVE_ENABLED=false
JIEJING_PUBLIC_SEARCH_API_KEY=inject-from-ssm

# Tencent CLS and COS.
JIEJING_CLS_ENABLED=true
JIEJING_CLS_REGION=ap-guangzhou
JIEJING_CLS_LOGSET_ID=replace-with-cls-logset-id
JIEJING_CLS_TOPIC_ID=replace-with-cls-topic-id
JIEJING_CLS_ALERT_POLICY_CONFIGURED=false
JIEJING_CLS_LIVE_PROBE_REQUIRED=true
JIEJING_CLS_LIVE_PROBE_LAST_AT=

JIEJING_BACKUP_STORAGE_PROVIDER=cos
JIEJING_COS_BACKUP_ENABLED=true
JIEJING_COS_REGION=ap-guangzhou
JIEJING_COS_BUCKET=replace-with-private-backup-bucket
JIEJING_COS_PREFIX=jiejing/staging/backups
JIEJING_COS_BACKUP_LIVE_PROBE_REQUIRED=true
JIEJING_COS_BACKUP_LAST_SUCCESS_AT=
JIEJING_BACKUP_POLICY_CONFIGURED=false
JIEJING_BACKUP_ALERTS_CONFIGURED=false
JIEJING_VAULT_BACKUP_POLICY_CONFIGURED=false
JIEJING_RESTORE_DRILL_LAST_AT=

JIEJING_ENABLE_REAL_PLATFORM_WRITES=false
