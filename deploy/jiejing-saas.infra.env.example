# Jiejing staging infrastructure rehearsal.
# Copy to deploy/jiejing-saas.infra.env on the server and replace passwords via
# the cloud secret manager. Do not commit the real file.

JIEJING_SAAS_ENV=staging
JIEJING_SAAS_SESSION_SECRET=replace-with-32-plus-random-characters
JIEJING_CORS_ORIGIN=https://individually-buffalo-prescribed-blocking.trycloudflare.com
JIEJING_ALLOW_HERMES_ADAPTERS=false
JIEJING_ENABLE_DEMO_SESSION_BOOTSTRAP=false
JIEJING_OPERATOR_BOOTSTRAP_SECRET=replace-with-operator-only-secret-if-needed

# Postgres is brought up and migrated by docker-compose.staging-infra.yml.
# The SaaS repository can switch to this Postgres URL when this file is used;
# run the cutover rehearsal before importing live staging data.
JIEJING_POSTGRES_DB=jiejing
JIEJING_POSTGRES_USER=jiejing
JIEJING_POSTGRES_PASSWORD=replace-password
JIEJING_DATABASE_ENGINE=postgres
JIEJING_DATABASE_ADAPTER=postgres-managed
JIEJING_DATABASE_URL=postgresql://jiejing:replace-password@postgres:5432/jiejing

# Redis Streams is the distributed delivery layer for the standalone worker.
# The database remains the merchant-visible system of record.
JIEJING_QUEUE_PROVIDER=redis_streams
JIEJING_QUEUE_URL=redis://redis:6379/0

# Vault/KMS boundary. HashiCorp Vault can be used for staging; Tencent KMS can
# replace it later without changing frontend or Runtime token boundaries.
JIEJING_VAULT_ENABLED=true
JIEJING_VAULT_PROVIDER=vault
JIEJING_VAULT_LIVE_RESOLVE_ENABLED=false
JIEJING_VAULT_ADDR=http://jiejing-vault:8200
JIEJING_VAULT_TOKEN=inject-at-runtime
JIEJING_VAULT_MOUNT=secret
JIEJING_VAULT_KEYSPACE=jiejing-staging
JIEJING_VAULT_KV_VERSION=v2
JIEJING_VAULT_PATH_TEMPLATE={keyspace}/{company_id}/{store_id}/{secret_ref}

# eBay remains read-only. Runtime/Agents never receive eBay tokens.
JIEJING_EBAY_OAUTH_ENV=production
JIEJING_EBAY_CLIENT_ID=inject-at-runtime
JIEJING_EBAY_CLIENT_SECRET=inject-at-runtime
JIEJING_EBAY_RU_NAME=inject-at-runtime
JIEJING_EBAY_OAUTH_EXCHANGE_LIVE=true
JIEJING_EBAY_TOKEN_REFRESH_LIVE=true
JIEJING_EBAY_READ_ONLY_LIVE=true
JIEJING_ENABLE_HERMES_EBAY_BRIDGE=false
JIEJING_ENABLE_HERMES_WSL_SECRET_LOOKUP=false
JIEJING_ALLOW_HERMES_MODEL_FALLBACK=false
JIEJING_EBAY_LOCAL_TOKEN_STORE_ENABLED=false
JIEJING_EBAY_ACCESS_TOKEN=
JIEJING_EBAY_REFRESH_TOKEN=

# Provider keys must be injected through Vault/KMS, never by frontend code.
JIEJING_MODEL=deepseek-chat
JIEJING_MODEL_BASE_URL=https://api.deepseek.com/v1
JIEJING_MODEL_API_KEY=inject-at-runtime
JIEJING_PUBLIC_SEARCH_LIVE_ENABLED=false
JIEJING_PUBLIC_SEARCH_API_KEY=inject-at-runtime

JIEJING_ENABLE_REAL_PLATFORM_WRITES=false
