FROM python:3.12.13-slim-trixie@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36 AS jiejing-wheel-builder

ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_INDEX_URL=https://mirrors.tencent.com/pypi/simple/
ENV PIP_TRUSTED_HOST=mirrors.tencent.com

WORKDIR /build

COPY requirements.saas.lock.txt /build/requirements.saas.lock.txt
COPY requirements.saas-build.lock.txt /build/requirements.saas-build.lock.txt

# The official CLS uploader currently constrains lz4 to a source-only release
# on Python 3.12. Keep compilation tools in this disposable wheel stage only.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && pip install --require-hashes --no-cache-dir -r requirements.saas-build.lock.txt \
    && pip wheel --use-pep517 --no-build-isolation --require-hashes --no-cache-dir --wheel-dir /wheels -r requirements.saas.lock.txt \
    && rm -rf /var/lib/apt/lists/*

FROM python:3.12.13-slim-trixie@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36 AS jiejing-runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_INDEX_URL=https://mirrors.tencent.com/pypi/simple/
ENV PIP_TRUSTED_HOST=mirrors.tencent.com

WORKDIR /app

COPY requirements.saas.lock.txt /app/requirements.saas.lock.txt

COPY --from=jiejing-wheel-builder /wheels /wheels

RUN pip install --no-cache-dir --no-index /wheels/*.whl \
    && rm -rf /wheels

COPY . /app

RUN python -m py_compile \
    tools/jiejing_saas_backend_cli.py \
    tools/jiejing_worker_cli.py \
    jiejing_saas/api_server.py \
    jiejing_saas/merchant_onboarding.py \
    jiejing_saas/media_source_assets.py \
    jiejing_saas/backup_plan.py \
    jiejing_saas/cos_backup_probe.py \
    jiejing_saas/billing_domestic.py \
    jiejing_saas/billing_operations_maintenance.py \
    jiejing_saas/billing_payment_options.py \
    jiejing_saas/billing_plan.py \
    jiejing_saas/billing_wechat_pay.py \
    jiejing_saas/commercial_launch_gate.py \
    jiejing_saas/ebay_data_packet.py \
    jiejing_saas/infrastructure_drivers.py \
    jiejing_saas/model_value_gate.py \
    jiejing_saas/model_value_rehearsal.py \
    jiejing_saas/postgres_repository_runtime.py \
    jiejing_saas/redis_queue_runtime.py \
    jiejing_saas/registration_challenge.py \
    jiejing_saas/staging_security_gate.py \
    jiejing_saas/worker.py \
    jiejing_saas/independence.py \
    tools/jiejing_a_class_unattended_gate.py \
    tools/jiejing_b_class_production_gate.py \
    tools/jiejing_c_class_production_gate.py \
    tools/jiejing_current_state_guard.py \
    tools/jiejing_cos_backup_probe.py \
    tools/jiejing_precloud_deployment_gate.py \
    jiejing_runtime/runtime.py

RUN python -c "import jiejing_saas.api_server; import jiejing_saas.repository"

EXPOSE 8788

CMD ["python", "tools/jiejing_saas_backend_cli.py", "serve", "--host", "0.0.0.0", "--port", "8788", "--db", "/data/saas.sqlite", "--runtime-db", "/data/runtime.sqlite", "--output-root", "/data/output"]
